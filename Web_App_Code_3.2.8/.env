NEXT_PUBLIC_WEB_VERSION="3.2.8"

NEXT_PUBLIC_API_URL="https://api.news.inqtube.com" # do not add '/' at the end
SERVER_API_URL="https://api.news.inqtube.com" # server-side requests should go directly to Laravel
NEXT_OUTPUT_EXPORT="false" # set true only when intentionally generating a static export
NEXT_PUBLIC_WEB_URL="https://news.inqtube.com" # do not add '/' at the end

# WEBSITE NAME
NEXT_PUBLIC_WEB_NAME="Deeprab Media"

# Loader Color
NEXT_PUBLIC_LOADER_COLOR="#EE2934"

# VAPID KEY — replace with your real Firebase VAPID key
NEXT_PUBLIC_VAPID_KEY="enter_here_your_vapid_key"

# FIREBASE — enter your real Firebase project credentials
NEXT_PUBLIC_API_KEY="enter_here_your_api_key"
NEXT_PUBLIC_AUTH_DOMAIN="enter_here_your_auth_domain"
NEXT_PUBLIC_PROJECT_ID="enter_here_your_project_id"
NEXT_PUBLIC_STORAGE_BUCKET="enter_here_your_storage_bucket"
NEXT_PUBLIC_MESSAGING_SENDER_ID="enter_here_your_messaging_sender_id"
NEXT_PUBLIC_APP_ID="enter_here_your_app_id"
NEXT_PUBLIC_MEASUREMENT_ID="enter_here_your_measurement_id"

# DEFAULT META TAGS
NEXT_PUBLIC_TITLE="Stay Informed with the Latest News | Deeprab Media"
NEXT_PUBLIC_DESCRIPTION="Get the latest news, updates, and stories across politics, business, technology, sports, entertainment, and more. Stay informed with ease."
NEXT_PUBLIC_kEYWORDS="Breaking news,Top stories,Headlines,Current events,Latest news,World news,National news,Local news,Politics,Business,Technology,Entertainment,Sports,Health,Science,Environment,Education,Crime,Immigration,Weather."

# SEO
NEXT_PUBLIC_SEO="false"

# API ENDPOINT — do not change
NEXT_PUBLIC_END_POINT="api"

# DEMO
NEXT_PUBLIC_DEMO="false"

# Inspect element in production
NEXT_PUBLIC_ALLOW_INSPECT="false"

# WEATHER API KEY — retain your existing key
NEXT_PUBLIC_WEATHER_API_KEY="d0f2f4dbecc043e78d6123135212408"

# Loading Min
NEXT_PUBLIC_LOAD_MIN=5

# PWA Config
NEXT_PUBLIC_PWA_ENABLED="true"